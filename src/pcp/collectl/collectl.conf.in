#
# pcp-collectl configuration file
# Installed at @PCP_SYSCONF_DIR@/collectl/collectl.conf
# See pcp-collectl(1) for full option descriptions.
#
# Command-line options always override settings here.
#

# Default subsystems for daemon mode (-D).
# Equivalent to collectl's SubsysCore setting.
#SubsysCore = bcdfijmnstx

# Collection intervals in seconds.
#Interval = 10
#Interval2 = 60
#Interval3 = 120

# Daemon-mode output: write PCP archives to PCP_LOG_DIR/collectl/
# and rotate at midnight, keeping 7 days.
DaemonCommands = -f @PCP_LOG_DIR@/collectl -r00:00,7 -m -F60

# Socket port for -A / colmux connectivity.
#Port = 2655
#Timeout = 10

# Disk device include filter (Perl regex, applied at collection time).
# Matches hd, sd, dm, nvme, virtio, xen, RBD, loop and MD devices.
DiskFilter = /hd[ab]|sd[a-z]+|dm-\d+|xvd[a-z]|vd[a-z]+|nvme\d+n\d+|rbd\d+|loop\d+|md\d+/

# Maximum number of processes to show with -s Z / --top.
#NumProcesses = 20
